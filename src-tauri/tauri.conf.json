{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wenyi Desktop",
  "version": "0.4.0",
  "identifier": "com.wenyi.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Wenyi - Carry stories across languages",
        "width": 1080,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/wenyi-core"],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["English", "SimpChinese"]
      }
    }
  },
  "plugins": {}
}