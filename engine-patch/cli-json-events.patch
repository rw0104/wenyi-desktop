+def _json_sink() -> JsonEventsSink:
+    """Return (and cache) the JSONL event sink for this invocation, if enabled."""
+    sink = _CONFIG.get("_json_events_sink")
+    if sink is None:
+        sink = JsonEventsSink()
+        _CONFIG["_json_events_sink"] = sink
+    return sink
+
+
+def _json_events_enabled() -> bool:
+    """Whether this invocation runs in machine-readable JSONL mode."""
+    return bool(_CONFIG.get("json_events"))
+
+
+def _bind_console_for_json_events() -> None:
+    """Send human-readable output to stderr, keeping stdout a pure JSONL stream.
+
+    Desktop clients parse stdout line by line; any Rich message mixed in would break
+    framing. Human progress, summaries and errors move to stderr, which clients treat
+    as a log channel.
+    """
+    global console
+    console = Console(stderr=True)
+
+
+def _emit_json_error(error: BaseException) -> None:
+    """Emit a terminal JSON ``error`` event when running in JSONL mode.
+
+    Desktop clients await a terminal event; without this an unexpected failure would
+    leave them blocked on a stream that simply stops.
+    """
+    if _json_events_enabled():
+        _json_sink().error(str(error) or type(error).__name__)
+
+
+@contextmanager
+def _progress_scope(orch: Any, initial: str) -> Iterator[Any]:
+    """Yield a ``ProgressFn`` callback, wrapping the client interrupt scope.
+
+    In normal CLI mode this enters a Rich ``Progress`` display and returns a
+    ``_RichProgressBridge``. In ``--json-events`` mode it skips terminal rendering and
+    returns the shared ``JsonEventsSink`` so structured events go to stdout instead.
+    """
+    if _json_events_enabled():
+        with orch.client.interrupt_scope():
+            yield _json_sink()
+        return
+    with (
+        orch.client.interrupt_scope(),
+        Progress(
+            *_progress_columns(),
+            console=console,
+        ) as prog,
+    ):
+        yield _RichProgressBridge(prog, initial)
+
